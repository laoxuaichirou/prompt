  "image_presets": [
    {
      "id": "creative-preset-0",
      "slot": "filter",
      "category": "通用",
      "name": "柯达",
      "prompt": "暖色胶片色彩，柔和高光过渡，自然肤色，细腻胶片颗粒。"
    },
    {
      "id": "creative-preset-1",
      "slot": "filter",
      "category": "通用",
      "name": "富士",
      "prompt": "清新绿色与蓝色，柔和对比，保留自然肤色和暗部细节。"
    },
    {
      "id": "creative-preset-2",
      "slot": "filter",
      "category": "通用",
      "name": "伊尔福",
      "prompt": "黑白银盐摄影，丰富灰阶，真实颗粒和清晰层次。"
    },
    {
      "id": "creative-preset-3",
      "slot": "filter",
      "category": "通用",
      "name": "电影胶片",
      "prompt": "电影负片色彩，克制饱和度，柔和高光和深邃阴影。"
    },
    {
      "id": "creative-preset-4",
      "slot": "filter",
      "category": "通用",
      "name": "宝丽来",
      "prompt": "即时成像色调，轻微褪色，温暖柔和的生活摄影质感。"
    },
    {
      "id": "creative-preset-5",
      "slot": "filter",
      "category": "通用",
      "name": "电影光效",
      "prompt": "有动机的电影布光，明确主辅光、轮廓光与空间层次。"
    },
    {
      "id": "creative-preset-6",
      "slot": "filter",
      "category": "通用",
      "name": "HDR",
      "prompt": "扩大明暗细节，保留自然对比，避免过度锐化和光晕。"
    },
    {
      "id": "creative-preset-7",
      "slot": "filter",
      "category": "通用",
      "name": "柔焦效果",
      "prompt": "柔和高光晕染，主体轮廓清晰，轻微扩散镜效果。"
    },
    {
      "id": "creative-preset-8",
      "slot": "filter",
      "category": "通用",
      "name": "胶片颗粒",
      "prompt": "增加细密自然胶片颗粒，保留皮肤和材质细节。"
    },
    {
      "id": "creative-preset-9",
      "slot": "filter",
      "category": "通用",
      "name": "赛博朋克",
      "prompt": "夜间霓虹青红对照，湿润反光环境，主体清晰。"
    },
    {
      "id": "creative-preset-10",
      "slot": "filter",
      "category": "通用",
      "name": "复古色调",
      "prompt": "暖黄褪色和低饱和阴影，复古生活摄影。"
    },
    {
      "id": "creative-preset-11",
      "slot": "filter",
      "category": "人像质感",
      "name": "清透美颜",
      "prompt": "清透自然肤色，保留微小皮肤纹理，不改变五官。"
    },
    {
      "id": "creative-preset-12",
      "slot": "filter",
      "category": "人像质感",
      "name": "柔肤美颜",
      "prompt": "柔化局部瑕疵但保留面部身份和自然纹理。"
    },
    {
      "id": "creative-preset-13",
      "slot": "filter",
      "category": "人像质感",
      "name": "细腻肌理",
      "prompt": "增强真实细微皮肤纹理，保留毛孔与自然肤色。"
    },
    {
      "id": "creative-preset-14",
      "slot": "filter",
      "category": "人像质感",
      "name": "奶油肌",
      "prompt": "柔润均匀的奶油肤感，避免塑料皮肤和过度磨皮。"
    },
    {
      "id": "creative-preset-15",
      "slot": "filter",
      "category": "人像质感",
      "name": "柔化质感",
      "prompt": "柔化皮肤高频噪点，保留眼睛、头发和面部结构。"
    },
    {
      "id": "creative-preset-16",
      "slot": "filter",
      "category": "人像质感",
      "name": "哑光肌理",
      "prompt": "控制油光，柔雾哑光肌肤，保留层次和真实纹理。"
    },
    {
      "id": "creative-preset-17",
      "slot": "preset",
      "category": "功能",
      "name": "全景图",
      "prompt": "将场景拓展为360度等距柱状投影全景，左右边缘连续，保留主体设计与空间逻辑。"
    },
    {
      "id": "creative-preset-18",
      "slot": "preset",
      "category": "功能",
      "name": "多机位九宫格",
      "prompt": "生成3×3九宫格，同一人物、服装、场景与光线，九个不同机位和景别，网格等大排列，无文字。"
    },
    {
      "id": "creative-preset-19",
      "slot": "preset",
      "category": "功能",
      "name": "人物三视图",
      "prompt": "生成同一角色正面、侧面和背面全身设计，三视图并列，同一身高比例、服装、配件和中性背景。"
    },
    {
      "id": "creative-preset-20",
      "slot": "preset",
      "category": "功能",
      "name": "4视图",
      "prompt": "生成同一角色正面、侧面、背面全身视图及面部特写，2×2排列，身份服装保持一致。"
    },
    {
      "id": "creative-preset-21",
      "slot": "preset",
      "category": "功能",
      "name": "人物设计图",
      "prompt": "制作角色设定页，包含全身主视图、服装配件和关键细节放大，统一身份、颜色与材质。"
    },
    {
      "id": "creative-preset-22",
      "slot": "preset",
      "category": "功能",
      "name": "场景设计图",
      "prompt": "制作场景概念设计页，包含全景、关键建筑和材质细节，统一世界观与照明。"
    },
    {
      "id": "creative-preset-23",
      "slot": "preset",
      "category": "功能",
      "name": "道具设计图",
      "prompt": "制作道具设计页，包含正侧背视图、结构拆解和材质细节，比例结构一致。"
    },
    {
      "id": "creative-preset-24",
      "slot": "preset",
      "category": "功能",
      "name": "3秒后",
      "prompt": "推演参考画面3秒后的动作状态，仅输出一个新的瞬间，保持人物、服装、场景和运动逻辑连续。"
    },
    {
      "id": "creative-preset-25",
      "slot": "preset",
      "category": "功能",
      "name": "5秒前",
      "prompt": "推演参考画面5秒前的动作状态，仅输出一个新的瞬间，保持人物、服装、场景和事件逻辑连续。"
    },
    {
      "id": "creative-preset-26",
      "slot": "preset",
      "category": "功能",
      "name": "电影级光影校正",
      "prompt": "保留构图人物和材质，校正主光、阴影方向、环境反射及色温，形成一致的电影级光照。"
    }
  ],
