  "bases": [
    {
      "asset_id": "base-portrait",
      "description": "原创约30岁成年人，正面略转15度、肩部以上肖像，头发不挡脸，无妆或淡妆，保留毛孔和少量真实皮肤细节；中灰背景、均匀自然光。16:9画面人脸居中，头顶下巴完整。"
    },
    {
      "asset_id": "base-scene",
      "description": "原创成年人坐在咖啡馆窗边，中景，有白色杯子、红色物件、绿色植物和明暗层次；曝光与白平衡自然，平衡冷暖，不提前加胶片滤镜。16:9。"
    },
    {
      "asset_id": "base-character",
      "description": "原创成年冒险者，中性非暴露服装，蓝灰短外套、米白衬衫、深色长裤、棕鞋与单肩包。单人全身正面，浅灰背景，所有配件清晰，留足边距。"
    },
    {
      "asset_id": "base-action",
      "description": "原创成年人站在咖啡馆桌旁，手伸向桌上白杯但尚未拿起；身体与手完整可见，物件关系清楚，16:9。"
    },
    {
      "asset_id": "base-prop",
      "description": "原创无品牌复古金属怀表，表冠与侧铰链清晰，素雅表盘，单物件完整，浅灰底；供道具多角度参考。"
    }
  ],
